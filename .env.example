# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com) for invite + report emails
RESEND_API_KEY=
RESEND_FROM="Tiger Projects <reports@yourdomain.com>"

# Random string; Vercel sends it to the cron routes automatically
CRON_SECRET=

# Optional: your public URL (falls back to the request host)
NEXT_PUBLIC_SITE_URL=
